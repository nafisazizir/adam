# Photon
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
# Optional. The only iMessage handles Adam answers, comma-separated: phone numbers in E.164 with the
# country code (+61412345678, not 0412 345 678) and Apple ID emails. A number and an email are
# different handles, so list each one you text from, including the owner.principalId already in
# home-target.json: every alias then acts as that recorded owner, so Notion stays connected. Unset,
# Adam answers only that recorded owner, or with no pointer the first person to text it directly.
# Every ignored message logs its sender's handle. SMS and RCS are never answered, only iMessage.
# The same phone numbers are the only ones allowed to call Adam, and the ones Adam rings: list the
# owner's phone in E.164 (next to their Apple ID email, if they text from that) or Adam can't ring them.
OWNER_IMESSAGE_HANDLES=

# Workouts
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
HEVY_WEBHOOK_SECRET=
NOTION_PLANS_DATA_SOURCE_ID=
NOTION_WORKOUTS_DATA_SOURCE_ID=

# Vercel
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Speech (text to speech routes through the AI Gateway)
SPEECH_MODEL=
SPEECH_VOICE=

# Transcription (audio to text routes through the AI Gateway)
TRANSCRIPTION_MODEL=

# App
USER_TIMEZONE=
BASE_URL=

# Upstash QStash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# riz-mcp
RIZ_MCP_URL=
RIZ_MCP_JWT_SECRET=

# Cloud coding agent. devin or cursor. Unset keeps Devin when Devin is configured, and uses Cursor
# only when Cursor is the one configured vendor. A missing vendor's credentials fail only that vendor's calls.
CODING_AGENT_PROVIDER=

# Devin (optional; Devin calls fail without both)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU_LIMIT=

# Cursor Cloud Agents (optional; Cursor calls fail without it). An API key from Cursor Dashboard → API Keys.
CURSOR_API_KEY=
# Optional model id from Cursor's GET /v1/models. Unset leaves the key's default model.
CURSOR_MODEL=

# Google (Gmail and Calendar, read-only; optional, the Google tools fail without it)
# The one Vercel Connect Google connector: its id (scl_…) or UID (google/adam-google), not its bare name; accounts are added in chat
GOOGLE_CONNECTOR=
# Optional. New mail as a trigger: the full Pub/Sub topic Gmail watches publish to, projects/<project>/topics/<topic>
GOOGLE_PUBSUB_TOPIC=
# Optional. The service account the push subscription signs its requests as; unset, every push is refused
GOOGLE_PUSH_SERVICE_ACCOUNT=
# Calls (one ElevenLabs voice agent on a Twilio number; optional, the calls routes refuse without
# them). Only a number that may text Adam over iMessage can call it. The production build creates
# and updates the ElevenLabs agent, its ask_adam tool and its webhooks from these; nothing is set
# up by hand in the ElevenLabs dashboard. call_owner rings the owner out from CALLS_PHONE_NUMBER with
# all three set, at the first E.164 number among the owner's iMessage handles.
# Shared secret ElevenLabs sends as the x-calls-secret header on the start webhook and ask_adam.
CALLS_TOOL_SECRET=
# An ElevenLabs API key with access to Agents, Workspace webhooks and Workspace secrets.
ELEVENLABS_API_KEY=
# Optional. The agent's voice; unset leaves whatever voice the agent has.
ELEVENLABS_VOICE_ID=
# Adam's number in E.164 (+612…), imported once in ElevenLabs → Phone Numbers; the sync assigns it
# to the agent.
CALLS_PHONE_NUMBER=
