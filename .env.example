# Photon
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
# Optional. The only iMessage handles Adam answers, comma-separated: phone numbers in E.164 with the
# country code (+61412345678, not 0412 345 678) and Apple ID emails. A number and an email are
# different handles, so list each one you text from, including the owner.principalId already in
# home-target.json: every alias then acts as that recorded owner, so Notion stays connected. Unset,
# Adam answers only that recorded owner, or with no pointer the first person to text it directly.
# Every ignored message logs its sender's handle. SMS and RCS are never answered, only iMessage.
OWNER_IMESSAGE_HANDLES=

# Workouts
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
HEVY_WEBHOOK_SECRET=
NOTION_PLANS_DATA_SOURCE_ID=
NOTION_WORKOUTS_DATA_SOURCE_ID=

# Vercel
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Speech (text to speech routes through the AI Gateway)
SPEECH_MODEL=
SPEECH_VOICE=

# Transcription (audio to text routes through the AI Gateway)
TRANSCRIPTION_MODEL=

# App
USER_TIMEZONE=
BASE_URL=

# Upstash QStash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# riz-mcp
RIZ_MCP_URL=
RIZ_MCP_JWT_SECRET=

# Devin (coding sessions; optional, the coding tools fail without them)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU_LIMIT=

# Google (Gmail and Calendar, read-only; optional, the Google tools fail without it)
# The one Vercel Connect Google connector (id or UID, e.g. adam-google); accounts are added in chat
GOOGLE_CONNECTOR=
