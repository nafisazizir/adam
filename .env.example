# Photon
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
# Optional. The one iMessage handle Adam answers: the phone number (+61412345678) or Apple ID email
# you text Adam from, as Photon reports the sender. Unset, the owner is the one already recorded as
# owner.principalId in home-target.json in the Blob store, or else the first person to text Adam
# directly. Adam logs the handle of every message it ignores, so a new number shows up in the logs.
OWNER_IMESSAGE_USER_ID=

# Workouts
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
HEVY_WEBHOOK_SECRET=
NOTION_PLANS_DATA_SOURCE_ID=
NOTION_WORKOUTS_DATA_SOURCE_ID=

# Vercel
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Speech (text to speech routes through the AI Gateway)
SPEECH_MODEL=
SPEECH_VOICE=

# Transcription (audio to text routes through the AI Gateway)
TRANSCRIPTION_MODEL=

# App
USER_TIMEZONE=
BASE_URL=

# Upstash QStash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# riz-mcp
RIZ_MCP_URL=
RIZ_MCP_JWT_SECRET=

# Devin (coding sessions; optional, the coding tools fail without them)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU_LIMIT=
