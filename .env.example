# Photon
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
# Optional. Extra iMessage handles Adam answers, comma-separated: phone numbers in E.164 with the
# country code (+61412345678, not 0412 345 678) and Apple ID emails. A number and an email are
# different handles, so list each one you text from. The owner already recorded as
# owner.principalId in home-target.json is always answered; with neither, the first person to text
# Adam directly becomes the owner. Adam acts as that recorded owner (else the first handle here) from
# every alias, so Notion stays connected. Every ignored message logs its sender's handle.
# SMS is never answered, only iMessage.
OWNER_IMESSAGE_HANDLES=

# Workouts
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
HEVY_WEBHOOK_SECRET=
NOTION_PLANS_DATA_SOURCE_ID=
NOTION_WORKOUTS_DATA_SOURCE_ID=

# Vercel
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Speech (text to speech routes through the AI Gateway)
SPEECH_MODEL=
SPEECH_VOICE=

# Transcription (audio to text routes through the AI Gateway)
TRANSCRIPTION_MODEL=

# App
USER_TIMEZONE=
BASE_URL=

# Upstash QStash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# riz-mcp
RIZ_MCP_URL=
RIZ_MCP_JWT_SECRET=

# Devin (coding sessions; optional, the coding tools fail without them)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU_LIMIT=
