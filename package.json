{
  "name": "adam",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build && node --import ./scripts/ts-resolve.ts scripts/sync-voice-agent.ts",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsgo",
    "test": "node --import ./scripts/test-hooks.ts --test \"agent/**/*.test.ts\"",
    "verify": "scripts/verify.sh",
    "sync:riz-mcp-skill": "node scripts/sync-riz-mcp-skill.ts",
    "sync:voice-agent": "node --import ./scripts/ts-resolve.ts scripts/sync-voice-agent.ts --now"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@upstash/qstash": "^2.11.1",
    "@vercel/blob": "2.8.0",
    "@vercel/connect": "2.4.1",
    "@vercel/functions": "3.9.11",
    "ai": "7.0.153",
    "eve": "^0.83.2",
    "heic-decode": "2.1.0",
    "jose": "6.2.12",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@typescript/native-preview": "7.0.0-dev.20260523.1"
  },
  "engines": {
    "node": "24.x"
  }
}
